{
  "name": "@feral-auth/vue-components",
  "version": "0.2.0",
  "description": "Fr* wrappers around Vuetify components, with one shared design and theme.",
  "keywords": [
    "vue",
    "vuetify",
    "components",
    "feral-auth"
  ],
  "license": "MIT",
  "author": "Erik Hage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErikHage/feral-vue-components.git"
  },
  "bugs": {
    "url": "https://github.com/ErikHage/feral-vue-components/issues"
  },
  "homepage": "https://github.com/ErikHage/feral-vue-components#readme",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "clean": "node --eval \"for (const dir of ['dist', 'coverage']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "npm run clean && npm run verify && node scripts/check-package.mjs"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "@mdi/font": ">=7",
    "vue": "^3.5.0",
    "vuetify": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@mdi/font": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.4.47",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14",
    "vuetify": "^4.3.3"
  }
}
